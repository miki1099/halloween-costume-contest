# Copy to .env on the server and change the values.
ADMIN_PASSWORD=change-me-to-something-long
# Guests open http(s)://<host>/?code=<PARTY_CODE> (put it in the QR code). Leave empty to disable.
PARTY_CODE=
# Behind a reverse proxy (Caddy/nginx) on the same host: only listen on localhost and trust X-Forwarded-For.
BIND_ADDRESS=0.0.0.0
TRUST_PROXY=false
